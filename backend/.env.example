PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/chatapp
# Long random string used to sign login tokens — NOT an expiry like "7d".
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
NODE_ENV=development

# Agora (voice & video calls) — https://console.agora.io
AGORA_APP_ID=your-agora-app-id
APP_CERTIFICATE=your-agora-app-certificate

# Comma-separated list of allowed frontend origins
FRONTEND_URL=http://localhost:5173,https://chatapp-two-rosy.vercel.app
