# Backend URL. Used as the proxy target in dev and as the API/socket URL in production.
VITE_API_URL=http://127.0.0.1:5000

# Giphy key for stickers & GIFs — https://developers.giphy.com
VITE_GIPHY_KEY=your-giphy-api-key

# Calls: auto (default) | always | never — see README "Troubleshooting calls"
VITE_CALL_RELAY=auto
